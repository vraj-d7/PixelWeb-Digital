---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Marquee from '../components/Marquee.astro';
import { getImage } from 'astro:assets';
import { site, steps, services } from '../data/site';
import { faq, stats, testimonials, values } from '../data/about';
import { packages } from '../data/services';
import { projects } from '../data/home';

// Photos for the hover preview on the service rows, resized and converted to WebP at build time.
const previews = await Promise.all(services.map((s) => getImage({ src: s.image, width: 760, format: 'webp', quality: 72 })));
// Placeholder quotes only show in local preview, never on the live site.
const quotes = testimonials.filter((t) => import.meta.env.DEV || !t.placeholder);
const quickFaq = faq.slice(0, 3);
const callUrl = site.bookingUrl || '/contact/';
// Pixel arrow for the scroll hint: [column, row] on a 3x4 grid.
const arrow = [[1, 0], [1, 1], [0, 2], [1, 2], [2, 2], [1, 3]];
---
<Layout>
	<!-- 1. Hero -->
	<section class="hero" data-bg="#0b0b0b">
		<canvas class="field" data-pixel-field aria-hidden="true"></canvas>
		<div class="wrap hero-inner">
			<div class="hero-text">
			<p class="kicker prompt"><span data-type="hello_world">hello_world</span><span class="cursor-blink" aria-hidden="true">_</span></p>
			<h1 data-hero-title>Meet Pixel<span class="accent">Web</span><br />Digital.</h1>
			<p class="lead" data-hero-fade>Websites that don't just look good — they bring you <span class="rot" data-rotate="customers,bookings,sales,enquiries,calls">customers</span>.</p>
			<div class="btn-row" data-hero-fade>
				<a class="btn btn-primary" href="/contact/" data-magnetic>Get a free consultation <Icon name="arrow" size={20} /></a>
				<a class="btn btn-ghost" href="/services/" data-magnetic>See what we do</a>
			</div>
			</div>
			<!-- The pixel icon is drawn on the background canvas, centred on this box (see pixel-field.ts). -->
			<div class="hero-slot" aria-hidden="true">
				<div class="icon-box" data-icon-box></div>
				<p class="play-hint note" data-hero-fade>&gt; now_building: <span class="shape-name" data-shape>web_design</span><br /><span class="dim">hover · click · play</span></p>
			</div>
		</div>
		<div class="wrap hero-foot" data-hero-fade>
			<p class="note"><span class="live" aria-hidden="true"></span>status: taking_new_projects</p>
			<p class="note scroll-hint">scroll
				<span class="px-arrow" aria-hidden="true">{arrow.map(([x, y]) => <i style={`grid-area:${y + 1}/${x + 1};--r:${y}`}></i>)}</span>
			</p>
		</div>
	</section>

	<Marquee />

	<!-- Statement -->
	<section class="section" data-bg="#0b0b0b">
		<div class="wrap">
			<p class="kicker" data-reveal>the short version</p>
			<p class="statement" data-scrub>We build websites that look sharp, load fast and <span class="accent">turn visitors into customers.</span>{' '}One team takes you from the first sketch to launch day, and sticks around after.</p>
		</div>
	</section>

	<!-- Process strip -->
	<section class="section" data-bg="#0b0b0b">
		<div class="wrap stack">
			<p class="kicker" data-reveal>how we work</p>
			<h2 data-split>Sketch to launch, <span class="accent">one team.</span></h2>
			<ol class="pstrip" data-pstrip>
				<span class="ps-line" aria-hidden="true"><i></i></span>
				{steps.map((s, i) => (
					<li class="ps-node">
						<span class="ps-dot" aria-hidden="true"><Icon name={s.icon} size={22} /></span>
						<p class="note">0{i + 1}</p>
						<h3>{s.title}</h3>
						<p>{s.body}</p>
					</li>
				))}
			</ol>
			<a class="btn btn-ghost ps-link" href="/about/#process" data-reveal data-magnetic>See how it works <Icon name="arrow" size={20} /></a>
		</div>
	</section>

	<!-- Services list with hover photos -->
	<section class="section" data-bg="#0b0b0b">
		<div class="wrap">
			<div class="svc-head">
				<div class="stack">
					<p class="kicker" data-reveal>what we do</p>
					<h2 data-split>Everything you<br />need online.</h2>
				</div>
				<a class="btn btn-ghost" href="/services/" data-reveal data-magnetic>All services <Icon name="arrow" size={20} /></a>
			</div>
			<ul class="svc-list">
				{services.map((s, i) => (
					<li data-reveal>
						<a class="svc" href="/services/">
							<span class="svc-num">0{i + 1}</span>
							<span class="svc-title">{s.title}</span>
							<span class="svc-short">{s.short}</span>
							<span class="svc-icon"><Icon name={s.icon} size={30} /></span>
						</a>
					</li>
				))}
			</ul>
		</div>
		<!-- Photo that follows the cursor over the service rows (desktop only, see motion.ts). -->
		<div class="svc-preview" aria-hidden="true">
			<div class="svc-frame">
				{previews.map((img, i) => (
					<img src={img.src} width="380" height="285" alt={services[i].imageAlt} loading="eager" decoding="async" />
				))}
			</div>
		</div>
	</section>

	<!-- Work showcase: pinned, scrolls sideways -->
	<section class="work" data-work data-bg="#0d1407">
		<div class="wrap work-head">
			<div class="stack">
				<p class="kicker">selected work</p>
				<h2>Things we <span class="accent">build.</span></h2>
			</div>
			<p class="note">{projects.some((p) => p.concept) ? 'concept builds · client work coming soon' : 'recent projects'}</p>
		</div>
		<div class="work-viewport">
			<div class="work-track" data-work-track>
				{projects.map((p) => (
					<article class="wcard" data-tilt data-cursor={p.concept ? 'concept' : 'view'} style={`--bg:${p.bg};--ac:${p.accent};--ink:${p.ink}`}>
						<div class="wscreen" aria-hidden="true">
							<div class="ws-nav"><b>{p.name}</b><span><i></i><i></i><i></i></span></div>
							<p class="ws-h">{p.headline}</p>
							<span class="ws-btn">Get started</span>
							<div class="ws-cards"><i></i><i></i><i></i></div>
						</div>
						<div class="wmeta">
							<div>
								<h3>{p.name}</h3>
								<p>{p.type}</p>
							</div>
							{p.concept ? <span class="tag">concept</span> : p.url && <a class="tag live" href={p.url} target="_blank" rel="noopener">visit ↗</a>}
						</div>
					</article>
				))}
				<a class="wcard wcard-cta" href="/contact/" data-cursor="let's talk">
					<p class="note">your project?</p>
					<p class="wcta-h">This spot is <span class="accent">yours.</span></p>
					<span class="btn btn-primary">Start a project <Icon name="arrow" size={18} /></span>
				</a>
			</div>
		</div>
	</section>

	<!-- Device mockups that scroll -->
	<section class="section devices" data-devices data-bg="#0b0b0b">
		<div class="wrap dev-grid">
			<div class="stack">
				<p class="kicker" data-reveal>built for every screen</p>
				<h2 data-split>Looks right <span class="accent">everywhere.</span></h2>
				<p class="lead" data-reveal>Laptop, tablet or phone: every site we build is designed for small screens first and tested on real devices.</p>
			</div>
			<div class="dev-stage" aria-hidden="true">
				<div class="laptop">
					<div class="lt-screen">
						<div class="site" data-scrollsite>
							<div class="s-nav"><b>Your<span>Brand</span></b><span><i></i><i></i><i></i><em></em></span></div>
							<div class="s-hero"><p>Your business,<br /><span>online.</span></p><em></em></div>
							<div class="s-img"></div>
							<div class="s-cards"><i></i><i></i><i></i></div>
							<div class="s-band"><b></b><b></b></div>
							<div class="s-cards"><i></i><i></i><i></i></div>
							<div class="s-foot"></div>
						</div>
					</div>
					<div class="lt-base"></div>
				</div>
				<div class="phone">
					<div class="ph-screen">
						<div class="site site-m" data-scrollsite>
							<div class="s-nav"><b>Your<span>Brand</span></b><span class="burger"><i></i><i></i></span></div>
							<div class="s-hero"><p>Your business,<br /><span>online.</span></p><em></em></div>
							<div class="s-img"></div>
							<div class="s-cards"><i></i><i></i><i></i></div>
							<div class="s-band"><b></b><b></b></div>
							<div class="s-foot"></div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Stats band -->
	<section class="stats-band" data-bg="#0b0b0b">
		<div class="wrap stats">
			{stats.map((s) => (
				<div class="stat" data-reveal>
					<p class="num"><span data-count={s.value}>{s.value}</span><span class="accent">{s.suffix}</span></p>
					<p class="label">{s.label}</p>
				</div>
			))}
		</div>
	</section>

	<!-- Stacking cards -->
	<section class="section" data-bg="#131313">
		<div class="wrap stack">
			<p class="kicker" data-reveal>why pixelweb</p>
			<h2 data-split>Why people <span class="accent">pick us.</span></h2>
			<div class="stack-cards" data-stack>
				{values.map((v, i) => (
					<article class={`scard s${i}`} style={`--i:${i}`}>
						<span class="sc-num">0{i + 1}</span>
						<div>
							<h3>{v.title}</h3>
							<p>{v.body}</p>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<!-- Packages teaser -->
	<section class="section" data-bg="#0b0b0b">
		<div class="wrap stack">
			<div class="svc-head">
				<div class="stack">
					<p class="kicker" data-reveal>packages</p>
					<h2 data-split>Pick a starting <span class="accent">point.</span></h2>
				</div>
				<a class="btn btn-ghost" href="/services/#packages" data-reveal data-magnetic>See what's included <Icon name="arrow" size={20} /></a>
			</div>
			<div class="pk-row">
				{packages.map((p) => (
					<a class:list={['pk', 'card', { popular: p.popular }]} href="/services/#packages" data-reveal data-spot>
						{p.popular && <span class="badge">most popular</span>}
						<h3>{p.name}</h3>
						<p class="price">{p.price || 'Custom quote'}</p>
						<p>{p.blurb}</p>
						<span class="pk-go"><Icon name="arrow" size={20} /></span>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- Testimonials -->
	{quotes.length > 0 && (
		<section class="section" data-bg="#0d1407">
			<div class="wrap stack">
				<p class="kicker" data-reveal>kind words</p>
				<div class="slider" data-slider data-reveal>
					{quotes.map((q, i) => (
						<figure class:list={['slide', { 'is-active': i === 0 }]}>
							{q.placeholder && <span class="ph-badge">placeholder · local preview only</span>}
							<blockquote>“{q.quote}”</blockquote>
							<figcaption><strong>{q.name}</strong> · {q.business}</figcaption>
						</figure>
					))}
					<div class="slide-pixels" aria-hidden="true" data-slide-pixels></div>
					{quotes.length > 1 && (
						<div class="dots">{quotes.map((_, i) => <button type="button" aria-label={`Show quote ${i + 1}`} class:list={{ on: i === 0 }} data-dot={i}></button>)}</div>
					)}
				</div>
			</div>
		</section>
	)}

	<!-- Mini FAQ + final nudge -->
	<section class="section" data-bg="#0b0b0b">
		<div class="wrap faq-grid">
			<div class="stack">
				<p class="kicker" data-reveal>good questions</p>
				<h2 data-split>Before you <span class="accent">ask.</span></h2>
				<div class="faq">
					{quickFaq.map((f, i) => (
						<details class="qa" data-reveal open={i === 0}>
							<summary><span>{f.q}</span><span class="plus" aria-hidden="true"></span></summary>
							<p>{f.a}</p>
						</details>
					))}
				</div>
				<a class="more-link" href="/about/" data-reveal>More answers on the About page →</a>
			</div>
			<div class="nudge card" data-reveal data-spot>
				<p class="note">&gt; still_unsure?</p>
				<h3>Let's just talk it through.</h3>
				<p>A free, no-pressure call. Tell us about your business and we'll tell you honestly what you need, and what you don't.</p>
				<a class="btn btn-primary" href={callUrl} target={site.bookingUrl ? '_blank' : undefined} rel={site.bookingUrl ? 'noopener' : undefined} data-magnetic>Book a free call <Icon name="arrow" size={20} /></a>
			</div>
		</div>
	</section>
</Layout>

<script>
	// Testimonial slider: auto-rotates with a pixel wipe between quotes.
	import gsap from 'gsap';
	const slider = document.querySelector<HTMLElement>('[data-slider]');
	if (slider) {
		const slides = [...slider.querySelectorAll<HTMLElement>('.slide')];
		const dots = [...slider.querySelectorAll<HTMLButtonElement>('[data-dot]')];
		// Small pixels for the wipe between quotes, sized to the slider (about 16px each).
		const grid = slider.querySelector<HTMLElement>('[data-slide-pixels]')!;
		let pixels: HTMLElement[] = [];
		let built = '';
		const buildPixels = () => {
			const PX = 16;
			const cols = Math.max(1, Math.ceil(grid.clientWidth / PX));
			const rows = Math.max(1, Math.ceil(grid.clientHeight / PX));
			if (built === `${cols}x${rows}`) return;
			built = `${cols}x${rows}`;
			grid.style.gridTemplateColumns = `repeat(${cols}, 1fr)`;
			grid.style.gridTemplateRows = `repeat(${rows}, 1fr)`;
			pixels = Array.from({ length: cols * rows }, () => document.createElement('i'));
			grid.replaceChildren(...pixels);
		};
		const motion = document.documentElement.classList.contains('motion');
		let cur = 0;
		let busy = false;
		const go = (n: number) => {
			if (busy || n === cur || slides.length < 2) return;
			const swap = () => {
				slides[cur].classList.remove('is-active');
				dots[cur]?.classList.remove('on');
				cur = n;
				slides[cur].classList.add('is-active');
				dots[cur]?.classList.add('on');
			};
			if (!motion) return swap();
			busy = true;
			buildPixels();
			gsap.timeline({ onComplete: () => void (busy = false) })
				.to(pixels, { opacity: 1, duration: 0.01, stagger: { amount: 0.4, from: 'random' } })
				.call(swap)
				.to(pixels, { opacity: 0, duration: 0.01, stagger: { amount: 0.4, from: 'random' } });
		};
		dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
		if (slides.length > 1) setInterval(() => !document.hidden && go((cur + 1) % slides.length), 5500);
	}
</script>

<style>
	.hero { position: relative; min-height: calc(100svh - 4.5rem); display: grid; grid-template-rows: 1fr auto; overflow: hidden; margin-top: -1px; }
	.field {
		position: absolute; inset: 0; width: 100%; height: 100%;
		mask-image: linear-gradient(100deg, rgb(0 0 0 / 0.35) 20%, #000 75%);
		-webkit-mask-image: linear-gradient(100deg, rgb(0 0 0 / 0.35) 20%, #000 75%);
	}
	.hero-inner {
		position: relative; z-index: 1; align-self: center; padding-block: clamp(4rem, 10vw, 7rem) 2rem; pointer-events: none;
		/* Text column is as wide as the text; the icon column takes the rest, so the icon sits centred between them. */
		display: grid; grid-template-columns: minmax(0, max-content) minmax(220px, 1fr); gap: 2rem; align-items: center;
	}
	.hero-text { display: grid; gap: 1.75rem; justify-items: start; }
	.hero-slot { display: grid; justify-items: center; gap: 1.5rem; pointer-events: none; }
	/* Leaves 2rem each side so the icon's 3D tilt never pokes outside the column. */
	.icon-box { width: min(100% - 4rem, 170px, 18svh); aspect-ratio: 1; }
	.hero-inner > * { pointer-events: auto; }
	/* Capped at 6rem so the headline and the pixel icon both fit inside the 72rem container on wide screens. */
	.hero h1 { font-size: clamp(3.25rem, 6.4vw, 6rem); line-height: 0.95; letter-spacing: -0.05em; }
	.hero .lead { max-width: 34rem; }
	.rot { color: var(--accent); font-weight: 600; white-space: nowrap; border-bottom: 2px solid currentColor; }
	.play-hint { margin: 0; color: var(--fg-3); white-space: nowrap; }
	.play-hint { text-align: center; line-height: 1.7; }
	.shape-name { color: var(--accent); display: inline-block; }
	.shape-name.flash { animation: shape-in 0.5s steps(4); }
	@keyframes shape-in { 0% { opacity: 0; transform: translateY(4px); } 100% { opacity: 1; transform: none; } }
	.play-hint .dim { color: #555; }
	.cursor-blink { animation: blink 1.1s steps(1) infinite; }
	@keyframes blink { 50% { opacity: 0; } }
	.hero-foot { position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: center; padding-block: 1.5rem; border-top: 1px solid var(--line); }
	.live { display: inline-block; width: 8px; height: 8px; background: var(--accent); margin-right: 0.6rem; animation: blink 1.4s steps(1) infinite; }
	.scroll-hint { display: inline-flex; align-items: center; gap: 0.75rem; }
	.px-arrow { display: inline-grid; grid-template-columns: repeat(3, 5px); grid-template-rows: repeat(4, 5px); gap: 2px; }
	.px-arrow i { background: #3a3a3a; animation: px-down 1.4s calc(var(--r) * 0.15s) infinite steps(1); }
	@keyframes px-down { 0%, 30% { background: var(--accent); } 31%, 100% { background: #3a3a3a; } }
	@media (max-width: 760px) {
		.field { mask-image: none; -webkit-mask-image: none; }
		.hero-inner { grid-template-columns: 1fr; gap: 1.5rem; padding-top: 2.5rem; }
		.hero-slot { order: -1; }
		.icon-box { width: min(26vw, 100px); }
		.play-hint { display: none; }
	}
	@media (max-width: 480px) { .scroll-hint { display: none; } }

	.statement { font-size: clamp(1.9rem, 4.6vw, 4rem); font-weight: 600; line-height: 1.12; letter-spacing: -0.035em; margin-top: 2rem; max-width: 62rem; }

	/* Process strip */
	.pstrip { --p: 0; position: relative; list-style: none; padding: 0; margin: 3rem 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
	.ps-line { position: absolute; left: 1.4rem; right: calc(33.3% - 1.4rem); top: 1.4rem; height: 2px; background: var(--line); }
	.ps-line i { display: block; height: 100%; background: var(--accent); transform: scaleX(var(--p)); transform-origin: left; }
	:global(html:not(.motion)) .pstrip { --p: 1; }
	.ps-node { position: relative; display: grid; gap: 0.5rem; align-content: start; }
	.ps-dot {
		width: 2.8rem; height: 2.8rem; display: grid; place-items: center; margin-bottom: 0.75rem; position: relative; z-index: 1;
		background: var(--bg); border: 2px solid var(--line); color: var(--fg-3); transition: background 0.35s, border-color 0.35s, color 0.35s;
	}
	.ps-node.is-on .ps-dot, :global(html:not(.motion)) .ps-dot { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
	.ps-node .note { color: var(--accent); }
	.ps-node h3 { font-size: 1.6rem; }
	.ps-node > p:last-child { color: var(--fg-2); }
	.ps-link { justify-self: start; margin-top: 1rem; }

	/* Services list */
	.svc-head { display: flex; align-items: end; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
	.svc-list { list-style: none; padding: 0; margin: 3.5rem 0 0; border-bottom: 1px solid var(--line); }
	.svc {
		position: relative; isolation: isolate; overflow: hidden;
		display: grid; grid-template-columns: 4rem 1fr auto 3rem; align-items: center; gap: 1.5rem;
		padding: clamp(1.5rem, 3vw, 2.25rem) 1rem; border-top: 1px solid var(--line);
		transition: color 0.45s cubic-bezier(0.7, 0, 0.2, 1);
	}
	.svc::before {
		content: ''; position: absolute; inset: 0; z-index: -1; background: var(--accent);
		transform: scaleY(0); transform-origin: top; transition: transform 0.55s cubic-bezier(0.7, 0, 0.2, 1);
	}
	.svc-num { font-family: var(--mono); font-weight: 700; color: var(--fg-3); transition: color 0.45s; }
	.svc-title { font-size: clamp(1.6rem, 4vw, 3rem); font-weight: 700; letter-spacing: -0.04em; line-height: 1.1; transition: transform 0.55s cubic-bezier(0.7, 0, 0.2, 1); }
	.svc-short { color: var(--fg-2); transition: color 0.45s; }
	.svc-icon { color: var(--accent); justify-self: end; transition: color 0.45s, transform 0.55s cubic-bezier(0.7, 0, 0.2, 1); }
	@media (hover: hover) {
		.svc:hover { color: var(--accent-ink); }
		.svc:hover::before { transform: scaleY(1); transform-origin: bottom; }
		.svc:hover .svc-title { transform: translateX(0.75rem); }
		.svc:hover .svc-num, .svc:hover .svc-short, .svc:hover .svc-icon { color: var(--accent-ink); }
		.svc:hover .svc-icon { transform: rotate(-8deg) scale(1.15); }
	}
	.svc-preview { position: fixed; top: 0; left: 0; z-index: 40; pointer-events: none; width: clamp(16rem, 24vw, 23.75rem); opacity: 0; visibility: hidden; }
	.svc-frame { position: relative; isolation: isolate; aspect-ratio: 4 / 3; overflow: hidden; border-radius: 1rem; background: var(--card); box-shadow: 0 30px 80px rgb(0 0 0 / 0.55), 0 0 0 1px rgb(255 255 255 / 0.06); }
	.svc-frame img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

	/* Work showcase */
	.work { padding-block: clamp(4rem, 8vw, 6rem); min-height: 100svh; display: grid; align-content: center; gap: 2.5rem; overflow: hidden; }
	.work-head { display: flex; justify-content: space-between; align-items: end; gap: 1rem; flex-wrap: wrap; }
	.work-head h2 { margin-top: 0.5rem; }
	.work-viewport { overflow: hidden; }
	.work-track { display: flex; gap: 1.5rem; padding-inline: max(1.25rem, calc((100vw - var(--max)) / 2)); width: max-content; will-change: transform; }
