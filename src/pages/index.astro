---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import Marquee from '../components/Marquee.astro';
import { getImage } from 'astro:assets';
import { steps, services } from '../data/site';

// Photos for the hover preview on the service rows, resized and converted to WebP at build time.
const previews = await Promise.all(services.map((s) => getImage({ src: s.image, width: 760, format: 'webp', quality: 72 })));
---
<Layout>
	<section class="hero">
		<canvas class="field" data-pixel-field aria-hidden="true"></canvas>
		<div class="wrap hero-inner">
			<p class="kicker prompt"><span data-type="hello_world">hello_world</span><span class="cursor-blink" aria-hidden="true">_</span></p>
			<h1 data-hero-title>Meet Pixel<span class="accent">Web</span><br />Digital.</h1>
			<p class="lead" data-hero-fade>Websites that don't just look good — they bring you customers.</p>
			<div class="btn-row" data-hero-fade>
				<a class="btn btn-primary" href="/contact/" data-magnetic>Get a free consultation <Icon name="arrow" size={20} /></a>
				<a class="btn btn-ghost" href="/services/" data-magnetic>See what we do</a>
			</div>
		</div>
		<div class="wrap hero-foot" data-hero-fade>
			<p class="note"><span class="live" aria-hidden="true"></span>status: taking_new_projects</p>
			<p class="note scroll-hint">scroll <span aria-hidden="true">↓</span></p>
		</div>
	</section>

	<Marquee />

	<section class="section">
		<div class="wrap">
			<p class="kicker" data-reveal>the short version</p>
			<p class="statement" data-scrub>We build websites that look sharp, load fast and <span class="accent">turn visitors into customers.</span>{' '}One team takes you from the first sketch to launch day, and sticks around after.</p>
		</div>
	</section>

	<section class="section">
		<div class="wrap stack">
			<p class="kicker" data-reveal>who we are</p>
			<h2 data-split>We design <span class="accent">and</span><br />develop websites.</h2>
			<p class="lead" data-reveal>One team from first sketch to final launch — no handoffs, no tech headaches for you.</p>
			<div class="grid-3 steps">
				{steps.map((step, i) => (
					<div class="card" data-reveal data-spot>
						<div class="step-top">
							<span class="icon"><Icon name={step.icon} size={36} /></span>
							<span class="note">0{i + 1}</span>
						</div>
						<h3>{step.title}</h3>
						<p>{step.body}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="wrap">
			<div class="svc-head">
				<div class="stack">
					<p class="kicker" data-reveal>what we do</p>
					<h2 data-split>Everything you<br />need online.</h2>
				</div>
				<a class="btn btn-ghost" href="/services/" data-reveal data-magnetic>All services <Icon name="arrow" size={20} /></a>
			</div>
			<ul class="svc-list">
				{services.map((s, i) => (
					<li data-reveal>
						<a class="svc" href="/services/">
							<span class="svc-num">0{i + 1}</span>
							<span class="svc-title">{s.title}</span>
							<span class="svc-short">{s.short}</span>
							<span class="svc-icon"><Icon name={s.icon} size={30} /></span>
						</a>
					</li>
				))}
			</ul>
		</div>
		<!-- Photo that follows the cursor over the service rows (desktop only, see motion.ts). -->
		<div class="svc-preview" aria-hidden="true">
			<div class="svc-frame">
				{previews.map((img, i) => (
					<img src={img.src} width="380" height="285" alt={services[i].imageAlt} loading="eager" decoding="async" />
				))}
			</div>
		</div>
	</section>

	<CtaBand />
</Layout>

<style>
	.hero { position: relative; min-height: calc(100svh - 4.5rem); display: grid; grid-template-rows: 1fr auto; overflow: hidden; margin-top: -1px; }
	.field {
		position: absolute; inset: 0; width: 100%; height: 100%;
		mask-image: linear-gradient(100deg, rgb(0 0 0 / 0.35) 20%, #000 75%);
		-webkit-mask-image: linear-gradient(100deg, rgb(0 0 0 / 0.35) 20%, #000 75%);
	}
	.hero-inner { position: relative; z-index: 1; align-self: center; padding-block: clamp(4rem, 10vw, 7rem) 2rem; display: grid; gap: 1.75rem; justify-items: start; pointer-events: none; }
	.hero-inner > * { pointer-events: auto; }
	.hero h1 { font-size: clamp(3.25rem, 11vw, 9rem); line-height: 0.95; letter-spacing: -0.05em; }
	.cursor-blink { animation: blink 1.1s steps(1) infinite; }
	@keyframes blink { 50% { opacity: 0; } }

	.hero-foot { position: relative; z-index: 1; display: flex; justify-content: space-between; padding-block: 1.75rem; border-top: 1px solid var(--line); }
	.live { display: inline-block; width: 8px; height: 8px; background: var(--accent); margin-right: 0.6rem; animation: blink 1.4s steps(1) infinite; }
	.scroll-hint span { display: inline-block; animation: nudge 1.6s ease-in-out infinite; }
	@keyframes nudge { 50% { transform: translateY(4px); } }
	@media (max-width: 480px) { .scroll-hint { display: none; } }

	.statement { font-size: clamp(1.9rem, 4.6vw, 4rem); font-weight: 600; line-height: 1.12; letter-spacing: -0.035em; margin-top: 2rem; max-width: 62rem; }

	.steps { margin-top: 3rem; }
	.step-top { display: flex; justify-content: space-between; align-items: flex-start; }

	.svc-head { display: flex; align-items: end; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
	.svc-list { list-style: none; padding: 0; margin: 3.5rem 0 0; border-bottom: 1px solid var(--line); }
	.svc {
		position: relative; isolation: isolate; overflow: hidden;
		display: grid; grid-template-columns: 4rem 1fr auto 3rem; align-items: center; gap: 1.5rem;
		padding: clamp(1.5rem, 3vw, 2.25rem) 1rem; border-top: 1px solid var(--line);
		transition: color 0.45s cubic-bezier(0.7, 0, 0.2, 1);
	}
	.svc::before {
		content: ''; position: absolute; inset: 0; z-index: -1; background: var(--accent);
		transform: scaleY(0); transform-origin: top; transition: transform 0.55s cubic-bezier(0.7, 0, 0.2, 1);
	}
	.svc-num { font-family: var(--mono); font-weight: 700; color: var(--fg-3); transition: color 0.45s; }
	.svc-title { font-size: clamp(1.6rem, 4vw, 3rem); font-weight: 700; letter-spacing: -0.04em; line-height: 1.1; transition: transform 0.55s cubic-bezier(0.7, 0, 0.2, 1); }
	.svc-short { color: var(--fg-2); transition: color 0.45s; }
	.svc-icon { color: var(--accent); justify-self: end; transition: color 0.45s, transform 0.55s cubic-bezier(0.7, 0, 0.2, 1); }
	@media (hover: hover) {
		.svc:hover { color: var(--accent-ink); }
		.svc:hover::before { transform: scaleY(1); transform-origin: bottom; }
		.svc:hover .svc-title { transform: translateX(0.75rem); }
		.svc:hover .svc-num, .svc:hover .svc-short, .svc:hover .svc-icon { color: var(--accent-ink); }
		.svc:hover .svc-icon { transform: rotate(-8deg) scale(1.15); }
	}
	.svc-preview {
		position: fixed; top: 0; left: 0; z-index: 40; pointer-events: none;
		width: clamp(16rem, 24vw, 23.75rem); opacity: 0; visibility: hidden;
	}
	.svc-frame {
		position: relative; isolation: isolate; aspect-ratio: 4 / 3; overflow: hidden; border-radius: 1rem;
		background: var(--card); box-shadow: 0 30px 80px rgb(0 0 0 / 0.55), 0 0 0 1px rgb(255 255 255 / 0.06);
	}
	.svc-frame img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
	@media (max-width: 760px) {
		.svc { grid-template-columns: 2.5rem 1fr; gap: 0.35rem 1rem; padding-inline: 0.25rem; }
		.svc-short { grid-column: 2; }
		.svc-icon { display: none; }
	}
</style>
