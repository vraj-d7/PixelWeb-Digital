---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found" noindex>
	<section class="section">
		<div class="wrap stack">
			<p class="kicker prompt">error_404</p>
			<h1 data-split>This pixel is <span class="accent">missing.</span></h1>
			<p class="lead">The page you're looking for doesn't exist or has moved.</p>
			<div class="btn-row"><a class="btn btn-primary" href="/">Back to home</a></div>
		</div>
	</section>
</Layout>
