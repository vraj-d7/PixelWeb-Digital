---
// Pixel "P" mark + wordmark, matching the Instagram slides.
const { mark = false } = Astro.props as { mark?: boolean };
const white = [[0,0],[1,0],[2,0],[3,0],[0,1],[0,2],[1,2],[2,2],[3,2],[0,3],[0,4]];
---
<span class="logo">
	<svg class="logo-mark" viewBox="0 0 20 20" aria-hidden="true">
		{white.map(([x, y]) => <rect x={x * 4} y={y * 4} width="3" height="3" fill="currentColor" />)}
		<rect x="16" y="4" width="3" height="3" fill="var(--accent)" />
	</svg>
	{!mark && <span class="logo-word">Pixel<span class="accent">Web</span> <span class="muted">Digital</span></span>}
</span>

<style>
	.logo { display: inline-flex; align-items: center; gap: 0.6rem; color: var(--fg); }
	.logo-mark { width: 1.6rem; height: 1.6rem; flex: none; }
	.logo-word { font-weight: 600; font-size: 1.15rem; letter-spacing: -0.02em; white-space: nowrap; }
	.muted { color: var(--fg-2); font-weight: 500; }
</style>
