---
import Logo from './Logo.astro';
import { nav } from '../data/site';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="header">
	<div class="wrap bar">
		<a href="/" aria-label="PixelWeb Digital home"><Logo /></a>
		<input type="checkbox" id="menu" class="menu-toggle" aria-label="Open menu" />
		<label for="menu" class="menu-btn" aria-hidden="true"><span></span><span></span></label>
		<nav aria-label="Main">
			{nav.map((item) => <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>)}
			<a href="/contact/" class="btn btn-primary nav-cta">Get a website</a>
		</nav>
	</div>
</header>

<style>
	.header { position: sticky; top: 0; z-index: 10; background: rgb(11 11 11 / 0.85); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
	.bar { display: flex; align-items: center; justify-content: space-between; height: 4.5rem; }
	nav { display: flex; align-items: center; gap: 2rem; }
	nav a:not(.btn) { color: var(--fg-2); font-weight: 500; transition: color 0.15s; }
	nav a:not(.btn):hover, nav a[aria-current='page'] { color: var(--fg); }
	nav a[aria-current='page']::before { content: '> '; color: var(--accent); font-family: var(--mono); }
	.nav-cta { padding: 0.6rem 1.15rem; font-size: 0.95rem; }
	.menu-toggle, .menu-btn { display: none; }

	@media (max-width: 760px) {
		.menu-btn { display: grid; gap: 6px; padding: 0.75rem; margin-right: -0.75rem; cursor: pointer; }
		.menu-btn span { display: block; width: 22px; height: 2px; background: var(--fg); transition: transform 0.2s; }
		.menu-toggle:checked + .menu-btn span:first-child { transform: translateY(4px) rotate(45deg); }
		.menu-toggle:checked + .menu-btn span:last-child { transform: translateY(-4px) rotate(-45deg); }
		nav {
			display: none; position: absolute; inset: 4.5rem 0 auto; flex-direction: column; align-items: stretch;
			gap: 0; padding: 0.5rem 1.25rem 1.5rem; background: var(--bg); border-bottom: 1px solid var(--line);
		}
		.menu-toggle:checked ~ nav { display: flex; }
		nav a:not(.btn) { padding: 0.9rem 0; font-size: 1.25rem; border-bottom: 1px solid var(--line); }
		.nav-cta { margin-top: 1.25rem; justify-content: center; }
	}
</style>
