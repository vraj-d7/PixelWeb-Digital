---
import Icon from './Icon.astro';
import { site } from '../data/site';
---
<section class="section">
	<div class="wrap">
		<div class="cta" data-reveal data-spot>
			<div class="pixels" aria-hidden="true">
				{Array.from({ length: 24 }, (_, i) => <i style={`--i:${i}`}></i>)}
			</div>
			<p class="kicker">let's work together</p>
			<h2 data-split>Ready to go <span class="accent">online?</span></h2>
			<p class="lead">Small business, startup or personal brand: we'll build your online home from scratch.</p>
			<div class="btn-row">
				<a class="btn btn-primary" href={site.instagram.dm} target="_blank" rel="noopener" data-magnetic>DM us “{site.instagram.keyword}” <Icon name="arrow" size={20} /></a>
				<a class="btn btn-ghost" href="/contact/" data-magnetic>Send a message</a>
			</div>
			<p class="small">Free consultation · No obligation</p>
		</div>
	</div>
</section>

<style>
	.cta { background: var(--bg-2); border: 1px solid var(--line); border-radius: calc(var(--radius) * 1.5); padding: clamp(2rem, 6vw, 5rem); display: grid; gap: 1.5rem; justify-items: start; }
	.cta h2 { font-size: clamp(2.5rem, 8vw, 6.5rem); letter-spacing: -0.05em; }
	.small { font-weight: 600; }

	/* Blinking pixel cluster in the corner */
	.pixels { position: absolute; top: clamp(1.5rem, 4vw, 3rem); right: clamp(1.5rem, 4vw, 3rem); display: grid; grid-template-columns: repeat(6, 14px); gap: 6px; z-index: -1; }
	.pixels i { width: 14px; height: 14px; background: var(--accent); opacity: 0.08; animation: px 3.2s calc(var(--i) * -0.37s) infinite steps(1); }
	@keyframes px { 0%, 70% { opacity: 0.08; } 72% { opacity: 0.9; } 85% { opacity: 0.35; } }
	@media (max-width: 640px) { .pixels { grid-template-columns: repeat(4, 10px); } .pixels i { width: 10px; height: 10px; } .pixels i:nth-child(n + 17) { display: none; } }
</style>
